msgid "Launch preview mode"
msgstr "Režim prikaza pre puštanja"

msgid "Keeps this product visible before stock arrives, hides stock notice, disables purchase, and shows the \"NOVO\" badge."
msgstr "Ostavlja proizvod vidljivim pre dolaska zaliha, skriva obaveštenje o stanju, onemogućava kupovinu i prikazuje oznaku „NOVO“."

msgid "Preview note"
msgstr "Napomena za prikaz"

msgid "Optional short text shown on the single product page while this product is in preview mode."
msgstr "Opcioni kratak tekst koji se prikazuje na stranici proizvoda dok je proizvod u režimu prikaza."

msgid "Preview"
msgstr "Prikaz"

msgid "No access"
msgstr "Nema pristupa"

msgid "Enabled"
msgstr "Uključeno"

msgid "Disabled"
msgstr "Isključeno"

msgid "Disable"
msgstr "Isključi"

msgid "Enable"
msgstr "Uključi"

msgid "All preview statuses"
msgstr "Svi statusi prikaza"

msgid "Preview enabled"
msgstr "Prikaz uključen"

msgid "Preview disabled"
msgstr "Prikaz isključen"

msgid "You do not have permission to do that."
msgstr "Nemate dozvolu za ovu radnju."

msgid "Enable launch preview mode"
msgstr "Uključi režim prikaza pre puštanja"

msgid "Disable launch preview mode"
msgstr "Isključi režim prikaza pre puštanja"

msgid "Preview products"
msgstr "Proizvodi u prikazu"

msgid "Launch preview mode enabled for %d product."
msgid_plural "Launch preview mode enabled for %d products."
msgstr[0] "Režim prikaza pre puštanja je uključen za %d proizvod."
msgstr[1] "Režim prikaza pre puštanja je uključen za %d proizvoda."

msgid "Launch preview mode disabled for %d product."
msgid_plural "Launch preview mode disabled for %d products."
msgstr[0] "Režim prikaza pre puštanja je isključen za %d proizvod."
msgstr[1] "Režim prikaza pre puštanja je isključen za %d proizvoda."
